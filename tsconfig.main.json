{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": ".",
    "outDir": "out/build",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/shared/**/*.ts", "src/core/**/*.ts","src/main/**/*.ts", "src/preload/**/*.ts", "scripts/**/*.ts"]
}
