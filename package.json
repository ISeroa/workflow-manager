{
  "name": "workflow-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code 기반 로컬 개발 워크플로 앱 (Windows MVP)",
  "main": "out/build/src/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "make-test-repo": "node scripts/make-test-repo.mjs",
    "e2e": "npm run build:main && node out/build/scripts/e2e.js",
    "smoke:ui": "npm run build && node scripts/smoke-ui.mjs",
    "doctor": "npm run build:main && node out/build/scripts/doctor.js",
    "smoke:doctor": "npm run build && node scripts/smoke-doctor.mjs"
  },
  "dependencies": {
    "picomatch": "^4.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22"
  }
}
